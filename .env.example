# Copy to .env for local runs. In GitHub Actions these come from repository secrets/variables.

# --- AI (Google Gemini free tier). Prefer a key from its own Google Cloud project:
# free-tier quotas are per project, so sharing a key with AI Newsroom halves both.
GEMINI_API_KEY=
# Model chains: the first model with remaining quota wins.
# LLM_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemma-4-31b-it
# LLM_EDITOR_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-flash-lite-latest,gemma-4-31b-it
# LLM_MAX_CALLS_PER_RUN=60
# LLM_MAX_CALLS_PER_DAY=600

# --- Telegram
# Bot from @BotFather, added as an admin (post messages) to the channel.
TELEGRAM_BOT_TOKEN=
# @channelname or numeric id (-100…)
TELEGRAM_CHANNEL_ID=
# Your private chat with the bot (send /start to it; id via getUpdates). Previews + approve/reject buttons go here.
TELEGRAM_ADMIN_CHAT_ID=

# --- Editorial
# true = build everything, send nothing. Switch to false only after reviewing output.
DRY_RUN=true
# review = every post waits for ✅ in the admin chat; auto = posts above the threshold go out directly
# (risky items still go to review). Can be changed at runtime with /mode in the admin chat.
PUBLISH_MODE=review
# PUBLISH_THRESHOLD=60
# BREAKING_THRESHOLD=90
# MAX_POSTS_PER_RUN=6
# DIGEST_HOUR_LOCAL=20
# TIMEZONE=Europe/Helsinki

# --- Storage / sources
# DATABASE_PATH=data/monitor.db
# SOURCES_FILE=config/sources.yaml
# GDELT_ENABLED=true
