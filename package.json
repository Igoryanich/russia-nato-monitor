{
  "name": "russia-nato-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous Russian-language Telegram monitor of Russia–NATO escalation signals",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cycle": "node src/cli.ts cycle",
    "quick": "node src/cli.ts quick",
    "posts": "node src/cli.ts posts",
    "digest": "node src/cli.ts digest",
    "report": "node src/cli.ts report",
    "admin": "node src/cli.ts admin",
    "test": "node --test \"tests/**/*.test.ts\"",
